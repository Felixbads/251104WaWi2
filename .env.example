# ENHANCED AUTHENTICATION CONFIGURATION
# Diese Datei zeigt alle benötigten Umgebungsvariablen für Enhanced-Auth

# Security Secrets (KRITISCH - In Produktion ändern!)
JWT_SECRET=your-super-secure-jwt-secret-change-in-production
COOKIE_SECRET=your-super-secure-cookie-secret-change-in-production
SESSION_SECRET=your-super-secure-session-secret-change-in-production

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# Replit Authentication (Automatisch gesetzt in Replit)
REPLIT_USER=username-from-replit
REPL_OWNER=owner-username-from-replit
REPL_ID=your-repl-id

# Auto-Approval Konfiguration
AUTO_APPROVAL_DOMAINS=yourdomain.com,anotherdomain.com

# Administrator-Konfiguration
ADMIN_USERS=admin1,admin2,owner-username

# Supervisor-Domains (E-Mail-Domains für Auto-Supervisor-Rechte)
SUPERVISOR_DOMAINS=management.company.com,supervisors.company.com

# Environment
NODE_ENV=development

# SMTP Configuration (bereits in .env.smtp)
SMTP_HOST=your-smtp-host
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=your-email@domain.com

# Rate Limiting Configuration
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Session Configuration
SESSION_TTL_HOURS=24
COOKIE_MAX_AGE_HOURS=24