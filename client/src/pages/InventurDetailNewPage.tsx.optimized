// Vereinfachter Handler zum Erstellen und Verknüpfen

// Mutation zum Aktualisieren des Batch für ein Inventurelement (ohne doppelte Invalidierungen)
const updateBatchMutation = useMutation({
  mutationFn: async (data: { itemId: number; batchId: number | null }) => {
    const apiEndpoint = `/api/inventory-counts/items/${data.itemId}/batch`;
    
    const response = await fetch(apiEndpoint, {
      method: 'PATCH',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({ batchId: data.batchId })
    });
    
    if (!response.ok) {
      const errorText = await response.text();
      throw new Error(`Fehler: ${response.status} - ${errorText}`);
    }
    
    return response.status === 204 ? {} : response.json();
  },
  onSuccess: (data, variables) => {
    // WICHTIG: Nur hier, im onSuccess Handler, invalidieren wir den Cache
    setTimeout(() => {
      queryClient.invalidateQueries({ 
        queryKey: [`/api/inventory-counts/${id}/items`],
        refetchType: 'none'  // Verhindert sofortiges Refetching
      });
    }, 300);

    // Dialog schließen
    setShowBatchDialog(false);
    setSelectedItem(null);
    
    // Erfolgsmeldung
    toast({
      title: "Charge verknüpft",
      description: "Die Charge wurde erfolgreich mit dem Artikel verknüpft."
    });
  }
});

// Kombinierter Handler zum Erstellen und Verknüpfen einer Charge
const handleCreateAndLink = async (batchData: { 
  productId: number; 
  batchNumber: string; 
  expiryDate: string | null;
  notes: string | null;
}) => {
  if (!selectedItem) return;
  
  try {
    // 1. Batch erstellen
    console.log("Erstelle neue Charge:", batchData);
    const response = await fetch('/api/inventory-counts/product-batches', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({
        ...batchData,
        warehouseId: inventurData!.warehouseId,
        initialQuantity: selectedItem.countedQuantity || 1,
        currentQuantity: selectedItem.countedQuantity || 1
      })
    });
    
    if (!response.ok) {
      const errorText = await response.text();
      throw new Error(`Fehler bei Batch-Erstellung: ${response.status} - ${errorText}`);
    }
    
    // 2. Batch-ID extrahieren
    const batch = await response.json();
    console.log("Neue Charge erstellt:", batch);
    
    // 3. Batch mit Item verknüpfen
    console.log(`Verknüpfe Batch ${batch.id} mit Item ${selectedItem.id}`);
    await updateBatchMutation.mutateAsync({ 
      itemId: selectedItem.id, 
      batchId: batch.id 
    });
    
    // 4. Charge zur lokalen Liste hinzufügen für optimistisches Update
    setAvailableBatches(prev => [...prev, batch]);
    
  } catch (error) {
    console.error("Fehler im kombinierten Prozess:", error);
    
    toast({
      title: "Fehler",
      description: "Die Charge konnte nicht erstellt oder verknüpft werden.",
      variant: "destructive",
    });
  }
};

// Vereinfachter Batch-Update-Handler (Entry Point)
const handleBatchUpdate = async (batchId: number | null) => {
  if (!selectedItem) return;
  
  try {
    if (batchId === null) {
      // Generiere automatisch eine neue Charge
      const now = new Date();
      const dateString = now.toISOString().split('T')[0].replace(/-/g, '');
      const timeString = `${now.getHours().toString().padStart(2, '0')}${now.getMinutes().toString().padStart(2, '0')}${now.getSeconds().toString().padStart(2, '0')}`;
      const random = Math.floor(Math.random() * 1000).toString().padStart(3, '0');
      const autoBatchNumber = `CHG-${dateString}-${timeString}-${random}`;
      
      // Automatisches Ablaufdatum (6 Monate)
      const expiryDate = new Date();
      expiryDate.setMonth(expiryDate.getMonth() + 6);
      const expiryDateString = expiryDate.toISOString().split('T')[0];
      
      // Sende Daten an den kombinierten Handler
      await handleCreateAndLink({
        productId: selectedItem.productId,
        batchNumber: autoBatchNumber,
        expiryDate: expiryDateString,
        notes: `Auto-erstellt bei Inventur #${id}` 
      });
    } else {
      // Existierende Charge verknüpfen
      await updateBatchMutation.mutateAsync({ 
        itemId: selectedItem.id, 
        batchId 
      });
    }
  } catch (error) {
    console.error('Fehler bei der Batch-Aktualisierung:', error);
    toast({
      title: "Fehler",
      description: "Die Charge konnte nicht verknüpft werden.",
      variant: "destructive",
    });
  }
};